<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎵 Klarnet"
            android:textSize="32sp"
            android:textColor="#E8D5B7"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nota Çalıcı"
            android:textSize="16sp"
            android:textColor="#A0A0C0"
            android:layout_marginBottom="24dp"/>

        <!-- Row 1: Do Re Mi Fa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_do"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Do\nC4"
                android:textSize="14sp"
                android:backgroundTint="#4A90D9"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btn_re"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="Re\nD4"
                android:textSize="14sp"
                android:backgroundTint="#5BA0E0"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btn_mi"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="Mi\nE4"
                android:textSize="14sp"
                android:backgroundTint="#6CB0E8"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btn_fa"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Fa\nF4"
                android:textSize="14sp"
                android:backgroundTint="#7DC0F0"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- Row 2: Sol La Si -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_sol"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Sol\nG4"
                android:textSize="14sp"
                android:backgroundTint="#8B6FB5"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btn_la"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="La\nA4"
                android:textSize="14sp"
                android:backgroundTint="#9E80C5"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btn_si"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Si\nB4"
                android:textSize="14sp"
                android:backgroundTint="#B191D5"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#3A3A5A"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yüksek Oktav"
            android:textSize="14sp"
            android:textColor="#A0A0C0"
            android:layout_marginBottom="12dp"/>

        <!-- Row 3: Do2 Re2 Mi2 Fa2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_do2"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Do\nC5"
                android:textSize="14sp"
                android:backgroundTint="#D4704A"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btn_re2"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="Re\nD5"
                android:textSize="14sp"
                android:backgroundTint="#E07D55"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btn_mi2"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="Mi\nE5"
                android:textSize="14sp"
                android:backgroundTint="#E88A60"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btn_fa2"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Fa\nF5"
                android:textSize="14sp"
                android:backgroundTint="#F09770"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- Row 4: Sol2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_sol2"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:text="Sol\nG5"
                android:textSize="14sp"
                android:backgroundTint="#C45FA0"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
